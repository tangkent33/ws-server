# ============================================================
#  範本檔：GitHub 上只放這份「敏感資料留空」的版本
#  複製成 .env 之後再把下面留空的值填回來（.env 永遠不進 git）
#     copy .env.example .env
# ============================================================

# ============================================================
#  Discord ⇄ Minecraft 橋接設定
#  改完要重跑 start.bat（或 run_bot.bat）才會生效
# ============================================================

# ------------------------------------------------------------ Discord
DISCORD_TOKEN=

# 留空 = 只用 bot 身分發到下面頻道；要用 webhook 另外發就填 URL
DISCORD_WEBHOOK_URL=

# 允許的伺服器 / 頻道（0 = 不限制伺服器）
ALLOWED_GUILD_ID=0
ALLOWED_CHANNEL_ID=

# ------------------------------------------------------------ Minecraft
MC_SERVER_IP=127.0.0.1
MC_WS_PORT=8000
MC_PLAYER_NAME=tangkent3

# ------------------------------------------------------------ 權限
# 授權的 Discord 使用者（ID 或名稱，逗號分隔）
DEFAULT_AUTHORIZED_USERS=
WHITELIST_FILE=whitelist.json

# ------------------------------------------------------------ 封禁名單
BLACKLIST_FILE=blacklist.json
# 偵測到 TP 平台拉人時要封多久（0 = 永久）
TP_BAN_MINUTES=0
# TP 平台拉人要不要自動寫進封禁名單（false = 只提示）
TP_AUTO_BLACKLIST=false
# 偵測到 TP 平台拉人時直接踢出（true = 自動踢）
TP_KICK=true
# 踢出時顯示的理由
TP_KICK_REASON=偵測到 TP 平台加入
# 同一個玩家幾秒內不重複踢（避免事件重複觸發刷屏）
TP_KICK_COOLDOWN=20
# 同一類 TP 提示幾秒內只發一次（避免外掛橫幅洗頻）
TP_ALERT_COOLDOWN=180
# 偵測到「玩家嘗試加入」時，要不要同時打在遊戲公屏上（走遊戲自己的 WebSocket，不需鍵盤注入）
TP_ANNOUNCE=true
# {player} 會換成玩家名；§ 是色碼
TP_ANNOUNCE_TEXT=§e[TP] §f玩家嘗試加入：§c{player}
# 封禁名單中的人加入時要不要自動踢（false = 只提示）
ENFORCE_BAN_ON_JOIN=true
# 外部封禁名單（BAN_RECORDS_API_BASE）命中是否直接踢（true=踢）
ENFORCE_EXTERNAL_BAN_ON_JOIN=true

# ------------------------------------------------------------ 聯機大廳（Miaaoo）
# 文件：https://docs.miaaoo.com　v2 介面
MIAAOO_API_BASE=https://api.miaaoo.com
# 自己的 XUID（16 位數字）。填了就完全跳過 /profile 查詢，換過 Gamertag 時特別有用
MC_XUID=

# miaaoo 官方用來發 Xbox 邀請的帳號（逗號分隔）。你加入房間後，平台用這批號加你好友 + 發邀請，
# 所以它們出現在 Xbox 邀請列表是正常的 —— 已設為豁免，任何情況都不會被踢。
# 後端會輪換，遇到新的直接補在這裡即可。
PLATFORM_INVITERS=Happy2026MC,HelloMC25,HelloMC25a,HelloMC25b5988,MCLobby26

# ------------------------------------------------------------ 外部封禁紀錄統計（狀態列顯示封禁人數）
# 位址與永久 Token 只留在本機，不上傳 GitHub；留空 = 狀態列不顯示這一段
BAN_RECORDS_API_BASE=
BAN_RECORDS_TOKEN=

# ------------------------------------------------------------ 指令佇列
# 遊戲 WebSocket 沒連線時，踢人/指令會排隊，連上後自動補送（不再用鍵盤注入）
KICK_QUEUE_TTL=600
KICK_QUEUE_MAX=50

# 關閉 bot 前要不要把 Discord 上的斜線指令一併刪掉（true = 離線就看不到指令）
# 建議保持 false：true 會在每次退出時清空指令，重啟再註冊時很容易撞 Discord 限流(429)，
# 造成「斜線指令消失」。
CLEAR_COMMANDS_ON_EXIT=false

# ------------------------------------------------------------ 狀態列
# 一行式狀態列（用 /statusboard start 建立）。刷新間隔秒數，別低於 30 以免撞 Discord 限流
STATUS_INTERVAL=60
# 讀不到遊戲 list 回顯時，顯示的玩家上限
MC_MAX_PLAYERS=20
# bot 重啟後自動接續上一次的狀態列（訊息還在就接著改）
STATUS_AUTO_START=true

# ------------------------------------------------------------ HTTP 封禁 API
# 只綁 127.0.0.1，不對外開放
BAN_API_PORT=3001
BAN_API_KEY=

# ------------------------------------------------------------ 事件開關
ENABLE_JOIN_LEAVE=true
ENABLE_DEATH=true
ENABLE_CHAT=true
ENABLE_COMMAND=true
ENABLE_TP_ALERT=true
ENABLE_BAN_ALERT=true

# ------------------------------------------------------------ 模式
# true  = 單向（只把遊戲事件送到 Discord）
# false = 雙向（Discord 聊天也會用 tellraw 送進遊戲）
ONE_WAY_MODE=false
# ------------------------------------------------------------ 訊息格式
CHAT_FORMAT_MC_TO_DC=**{sender}**: {message}
CHAT_FORMAT_DC_TO_MC=§c[§6tangkent3 - Discord] §b{username}§e: {message}

# ------------------------------------------------------------ 保留（目前程式沒讀，留著不影響）
LOG_CHANNEL_ID=
OWNER_ID=
COMMAND_BLACKLIST=stop,op,deop,ban,pardon,kick,gamemode,give,clear,kill
